{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./.types",
    "types": ["vite/client", "node"]
  },
  "include": ["./src"],
  "exclude": [
    "./src/**/*.stories.ts",
    "./src/**/*.stories.tsx",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/**/*.bench.ts",
    "./src/**/*.bench.tsx",
    "./src/**/stories/**",
    "./src/story-decorator/**",
    "./src/tests/**"
  ]
}
