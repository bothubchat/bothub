{
  "name": "@bothub-chat/packages",
  "private": true,
  "version": "2.0.0",
  "description": "Bothub packages",
  "license": "MIT",
  "author": "dev2alert <atmpotn@yandex.ru>",
  "homepage": "https://bothub.chat/",
  "workspaces": [
    "./packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx ./scripts/build.ts --watch",
    "build": "cross-env NODE_ENV=production tsx ./scripts/build.ts",
    "build:analyze": "cross-env ANALYZE=1 yarn build",
    "release": "yarn build && yarn run publish",
    "sb": "storybook dev -p 6006",
    "build:sb": "storybook build",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit -p ./tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "yarn lint --fix",
    "commitlint": "commitlint --edit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "publish": "tsx ./scripts/publish.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.23.3",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@dnd-kit/core": "^6.1.0",
    "@rollup/plugin-alias": "^5.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-image": "^3.0.2",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@storybook/testing-library": "^0.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/debug": "4.1.12",
    "@types/node": "^20.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.1.31",
    "babel-plugin-styled-components": "^2.1.4",
    "cosmiconfig": "9.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "eslint": "8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-storybook": "^10.6.3",
    "eslint-plugin-testing-library": "^6.1.1",
    "flat": "^6.0.1",
    "highlight.js": "^11.9.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "katex": "^0.19.1",
    "lint-staged": "^15.4.3",
    "normalize.css": "^8.0.1",
    "prettier": "^3.4.2",
    "rc-slider": "^11.1.8",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "rollup": "^3.29.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-esbuild": "^5.0.0",
    "rollup-plugin-node-externals": "^6.1.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "simple-git": "^4.0.2",
    "storybook": "^10.6.3",
    "string-width": "4.2.0",
    "strip-ansi": "6.0.0",
    "style-inject": "^0.3.0",
    "styled-components": "6.1.19",
    "stylis": "^4.3.1",
    "terser": "5.43.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "yaml": "2.8.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint"
  },
  "resolutions": {
    "katex": "^0.19.1",
    "vite": "^7.3.7"
  }
}
